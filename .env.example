# 复制为 .env.local 后按需修改（.env.local 不进版本库）

# 站点基础路径：本地 /，GitHub Pages /仓库名/
VITE_BASE=/

# 后端接口前缀（Nginx 同域部署时保持 /api）
VITE_API_BASE=/api

# 图片/上传文件前缀，后端返回相对路径时用于拼完整 URL
VITE_UPLOAD_BASE=

# 是否使用内置演示数据（GitHub Pages 演示版必须为 true）
VITE_USE_MOCK=true

# 开发时 vite 代理目标（仅本地用，生产不生效）
VITE_PROXY_TARGET=http://127.0.0.1:8080
